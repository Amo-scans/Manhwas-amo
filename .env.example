VITE_SITE_URL="https://assia123y.github.io/Manhwas-amo"

# Sous-chemin de dÃ©ploiement, avec slash de tÃªte ET de queue.
# GitHub Pages projet : "/<depot>/" ; domaine racine ou Cloudflare : "/".
