# -----------------------------------------------------------------------------
# Supabase â€” variables serveur (SSR Cloudflare Workers, scripts de build)
# -----------------------------------------------------------------------------
# URL du projet Supabase (visible par tous, sans danger).
SUPABASE_URL="https://<project-ref>.supabase.co"

# ClÃ© anon / publishable du projet. PUBLIQUE par conception : elle est dÃ©jÃ 
# embarquÃ©e dans le JavaScript envoyÃ© aux navigateurs et protÃ©gÃ©e par les
# politiques RLS de la base.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...> ou eyJhbGciOi... (JWT anon)"

# âš ï¸ SERVEUR UNIQUEMENT â€” ne jamais exposer au client, ne jamais committer.
# Bypasse intÃ©gralement les politiques RLS. UtilisÃ©e par
# src/integrations/supabase/client.server.ts (opÃ©rations d'administration).
# En SSR : secret Cloudflare Worker (wrangler secret put) ou variable d'env
# locale non committÃ©e. Absente / vide = le client admin Ã©choue proprement.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Supabase â€” variables client (prÃ©fixe VITE_, injectÃ©es au build)
# -----------------------------------------------------------------------------
# Reprennent les deux valeurs publiques ci-dessus.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...> ou eyJhbGciOi... (JWT anon)"
# Facultatif : identifiant du projet (informatif, repris de l'intÃ©gration Lovable).
