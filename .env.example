# =============================================================================
# AMO-SCANS-FR — modèle de variables d'environnement
# =============================================================================
# Copier ce fichier vers `.env` puis renseigner les valeurs :
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
#
# `.env` est ignoré par git (voir .gitignore). `.env.production` est, lui,
# COMMITTÉ avec des valeurs publiques uniquement.
#
# Rappel : tout ce qui commence par VITE_ est INJECTÉ DANS LE BUNDLE CLIENT.
# N'y mettez jamais de secret (clé service_role, mot de passe, jeton privé).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — variables serveur (SSR Cloudflare Workers, scripts de build)
# -----------------------------------------------------------------------------
# URL du projet Supabase (visible par tous, sans danger).
SUPABASE_URL="https://<project-ref>.supabase.co"

# Clé anon / publishable du projet. PUBLIQUE par conception : elle est déjà
# embarquée dans le JavaScript envoyé aux navigateurs et protégée par les
# politiques RLS de la base.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...> ou eyJhbGciOi... (JWT anon)"

# ⚠️ SERVEUR UNIQUEMENT — ne jamais exposer au client, ne jamais committer.
# Bypasse intégralement les politiques RLS. Utilisée par
# src/integrations/supabase/client.server.ts (opérations d'administration).
# En SSR : secret Cloudflare Worker (wrangler secret put) ou variable d'env
# locale non committée. Absente / vide = le client admin échoue proprement.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Supabase — variables client (préfixe VITE_, injectées au build)
# -----------------------------------------------------------------------------
# Reprennent les deux valeurs publiques ci-dessus.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...> ou eyJhbGciOi... (JWT anon)"
# Facultatif : identifiant du projet (informatif, repris de l'intégration Lovable).
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# -----------------------------------------------------------------------------
# SEO / déploiement statique
# -----------------------------------------------------------------------------
# Origine publique absolue du site, sans slash final.
# Sert aux balises canonical / Open Graph / sitemap (src/lib/seo.ts).
# GitHub Pages projet : https://<utilisateur>.github.io/<depot>
VITE_SITE_URL="https://assia123y.github.io/amo-scans-fr"

# Sous-chemin de déploiement, avec slash de tête ET de queue.
# GitHub Pages projet : "/<depot>/" ; domaine racine ou Cloudflare : "/".
# Consommé par vite.config.ts (base) et par le routeur (import.meta.env.BASE_URL).
VITE_BASE_PATH="/amo-scans-fr/"

# -----------------------------------------------------------------------------
# Déploiement Cloudflare Workers (facultatif, voir DEPLOY.md)
# -----------------------------------------------------------------------------
# Ces deux valeurs ne sont PAS lues par l'application : elles ne servent qu'à
# l'authentification de `wrangler deploy` en CI (GitHub Actions > Secrets).
# CLOUDFLARE_API_TOKEN="<token scoped Workers Scripts:Edit>"
# CLOUDFLARE_ACCOUNT_ID="<account id>"
